# Copy to .env (git-ignored) and fill in. Never commit real keys.
DOCPILOT_ENV=local
DOCPILOT_DATABASE_URL=postgresql://docpilot:docpilot@localhost:5432/docpilot

# LLM providers: each one with a key is enabled
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Default model for answers (the UI and API can pick any allowlisted one per request)
DOCPILOT_LLM_PROVIDER=anthropic
# DOCPILOT_LLM_MODEL=claude-opus-5-5
